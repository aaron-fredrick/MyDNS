# MyDNS Production & Development Configuration (TOML format)
# Copy this file to config.toml and customize credentials and settings.

[system]
# IANA timezone used for calendar-day metrics and other application-local
# calendar semantics. Storage and time-series timestamps remain UTC.
timezone = "UTC"

[server]
bind_host = "127.0.0.1"
dns_port = 53
http_host = "127.0.0.1"
http_port = 8080
run_as_user = "nobody"
run_as_group = "nobody"

[database]
path = "mydns.db"
# Separate SQLite store for operational metrics and future observability data.
observability_path = "observability.db"

[auth]
admin_username = "admin"
admin_password = "CHANGE_ME"

[resolver]
mode = "forwarding"
priority = "cloudflare_first"
cloudflare_dns = "1.1.1.1:53"
# router_dns = "192.168.1.1:53"

[zones]
authoritative = ["mydns.local"]
dashboard_domain = "mydns.local"
cors_domains = ["mydns.local"]
